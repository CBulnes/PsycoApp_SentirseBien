@model PsycoApp.site.Models.ProductosMantenimientoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Productos y tipos de terapia";
    var productos = Model.Productos;
}

<link rel="stylesheet" href="~/src/css/sb-pacientes.css?ver=005" />

<div class="sb-pa-container">
    <div class="sb-pa-container-buscar">
        <div class="sb-pa-container-buscar-title">
            <p class="active-titular-modulo">Búsqueda y registro de productos y terapias</p>
        </div>

        <div class="sb-pa-container-buscador">
            <div class="sb-pa-container-buscador-block">
                <button class="active-button-modulo" type="button" onclick="nuevoProducto()">
                    <i class="fa fa-plus"></i>&nbsp;Agregar
                </button>
            </div>
            <div class="sb-pa-container-buscador-block">
                <div class="sb-pa-container-buscador-block-item">
                    <span class="label-form active-texto-modulo">Nombre del producto o terapia:</span>
                    <input id="txtBuscarProducto" class="active-input-modulo" placeholder="Ingrese nombre para buscar" type="text" />
                    <button class="active-button-modulo" type="button" onclick="buscarProducto()">
                        <i class="fa fa-search"></i>&nbsp;Buscar
                    </button>
                </div>
            </div>
        </div>

        <div id="containerTabla" class="sb-pa-container-table">
            <table class="table table-striped active-table-modulo">
                <thead>
                    <tr>
                        <th>Nombre</th><th>Precio</th><th>Color</th><th>Evaluación</th><th>Sesiones</th><th>Siglas</th><th>Mostrar</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="bdProductos">
                    @if (productos != null && productos.Any())
                    {
                        @foreach (var p in productos)
                        {
                            <tr>
                                <td>@p.Nombre</td><td>@p.Precio</td><td>@p.Color</td><td>@(p.EsEvaluacion ? "Sí" : "No")</td><td>@p.NumSesiones</td><td>@p.Siglas</td><td>@(p.Mostrar == 1 ? "Sí" : "No")</td>
                                <td>
                                    <div class="sb-pa-container-tble-td">
                                        <button type="button" class="btn btn-sm sb-pa-container-table-button-edit active-button-tabla-modulo" onclick="editarProducto(this)" data-id="@p.Id" data-nombre="@p.Nombre" data-precio="@p.Precio" data-color="@p.Color" data-evaluacion="@p.EsEvaluacion" data-sesiones="@p.NumSesiones" data-siglas="@p.Siglas" data-mostrar="@p.Mostrar">Editar</button>
                                        <button type="button" class="btn btn-sm sb-pa-container-table-button-delet active-button-tabla-modulo" onclick="eliminarProducto(@p.Id)">Desactivar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8">No se encontraron productos o terapias.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="productoModal" class="modal sb-pa-container-agregar" style="display: none;">
    <div class="sb-pa-container-agregar-popup active-fondo-oscuro">
        <p id="productoModalTitulo" class="active-titular-modulo">Agregar producto o terapia</p>
        <form id="formProducto">
                <input type="hidden" id="productoId" value="0" />
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Nombre (*)</span><input id="productoNombre" class="form-control active-input-modulo" maxlength="100" required /></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Precio (*)</span><input id="productoPrecio" class="form-control active-input-modulo" type="number" min="0" step="0.01" required /></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Color</span><input id="productoColor" class="form-control active-input-modulo" type="color" /></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Es evaluación</span><select id="productoEvaluacion" class="form-control active-select-modulo"><option value="false">No</option><option value="true">Sí</option></select></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Número de sesiones</span><input id="productoSesiones" class="form-control active-input-modulo" type="number" min="0" value="0" /></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Siglas</span><input id="productoSiglas" class="form-control active-input-modulo" maxlength="10" /></div>
            </div>
            <div class="sb-frm-agregar-block">
                <div class="sb-frm-agregar-block-item"><span class="label-form active-texto-modulo">Mostrar en agenda</span><select id="productoMostrar" class="form-control active-select-modulo"><option value="1">Sí</option><option value="0">No</option></select></div>
            </div>
            <div class="sb-frm-agregar-block-button text-right">
                <button type="button" class="btn btn-success active-button-modulo" onclick="guardarProducto()">Guardar</button>
                <button type="button" class="btn btn-secondary active-button-modulo" onclick="cerrarProducto()">Cancelar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function nuevoProducto() {
        $('#productoId').val(0); $('#productoNombre').val(''); $('#productoPrecio').val('0');
        $('#productoColor').val('#000000'); $('#productoEvaluacion').val('false'); $('#productoSesiones').val(0);
        $('#productoSiglas').val(''); $('#productoMostrar').val(1); $('#productoModalTitulo').text('Agregar producto o terapia');
        $('.sb-admninistrator').css('overflow', 'hidden'); $('#productoModal').css('display', 'flex');
    }
    function editarProducto(button) {
        var p = $(button).data();
        $('#productoId').val(p.id); $('#productoNombre').val(p.nombre); $('#productoPrecio').val(parseFloat(p.precio));
        $('#productoColor').val(p.color || '#000000'); $('#productoEvaluacion').val(String(p.evaluacion) === 'true' ? 'true' : 'false');
        $('#productoSesiones').val(p.sesiones); $('#productoSiglas').val(p.siglas || ''); $('#productoMostrar').val(p.mostrar);
        $('#productoModalTitulo').text('Editar producto o terapia');
        $('.sb-admninistrator').css('overflow', 'hidden'); $('#productoModal').css('display', 'flex');
    }
    function cerrarProducto() {
        $('#productoModal').hide(); $('.sb-admninistrator').css('overflow', 'auto');
    }
    function buscarProducto() {
        var nombre = $('#txtBuscarProducto').val().trim().toLowerCase();
        $('#bdProductos tr').each(function () {
            $(this).toggle($(this).children('td').first().text().toLowerCase().includes(nombre));
        });
    }
    function guardarProducto() {
        var precio = parseFloat($('#productoPrecio').val());
        if (!$('#productoNombre').val().trim() || isNaN(precio) || precio < 0) { alert('Ingrese nombre y precio válidos.'); return; }
        var p = { Id: parseInt($('#productoId').val()), Nombre: $('#productoNombre').val().trim(), Precio: precio.toFixed(2),
            Color: $('#productoColor').val(), EsEvaluacion: $('#productoEvaluacion').val() === 'true', NumSesiones: parseInt($('#productoSesiones').val()) || 0,
            Siglas: $('#productoSiglas').val().trim(), Mostrar: parseInt($('#productoMostrar').val()) };
        $.ajax({ url: '/Mantenimiento/Producto/Guardar', type: 'POST', contentType: 'application/json', data: JSON.stringify(p) })
            .done(function () { cerrarProducto(); location.reload(); }).fail(function (xhr) { alert(xhr.responseText || 'No se pudo guardar el producto.'); });
    }
    function eliminarProducto(id) {
        if (!confirm('¿Desea desactivar este producto?')) return;
        $.post('/Mantenimiento/Producto/Eliminar/' + id).done(function () { location.reload(); })
            .fail(function (xhr) { alert(xhr.responseText || 'No se pudo desactivar el producto.'); });
    }
</script>
}
