@model PsycoApp.site.Models.RegistroSaasViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f7f5" />
    <title>Crear tu espacio | PsycoApp</title>
    <link rel="stylesheet" href="~/login/vendor/bootstrap/css/bootstrap.min.css" />
    <style>
        :root { --ink: #202b35; --muted: #718079; --sage: #4e7469; --sage-dark: #365c52; --line: #e5ebe6; --paper: #fffefa; }
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; color: var(--ink); background: #f4f7f5; font-family: Inter, "Segoe UI", Arial, sans-serif; }
        .topbar { height: 76px; padding: 0 clamp(22px, 7vw, 110px); display: flex; align-items: center; justify-content: space-between; background: rgba(255,254,250,.9); border-bottom: 1px solid #e9ede9; }
        .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-family: "Segoe UI", Arial, sans-serif; font-size: 21px; font-style: italic; font-weight: 750; letter-spacing: -1.1px; text-decoration: none; }
        .brand-word { display: inline-block; transform: skewX(-7deg); }
        .brand-mark { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 10px; color: white; background: var(--sage); font-size: 16px; }
        .top-link, .back-link { color: var(--sage-dark); font-size: 14px; font-weight: 650; text-decoration: none; }
        .top-link:hover, .back-link:hover { color: #27483f; text-decoration: underline; }
        .page { width: min(1120px, calc(100% - 40px)); margin: 42px auto 56px; display: grid; grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr); overflow: hidden; border: 1px solid #e7ece7; border-radius: 24px; background: var(--paper); box-shadow: 0 24px 70px #33483b14; }
        .intro { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 700px; padding: 52px 46px; overflow: hidden; background: linear-gradient(155deg, #e8f0eb 0%, #f1f5ef 56%, #e6eeea 100%); }
        .intro:after { content: ""; position: absolute; width: 350px; height: 350px; right: -155px; bottom: -110px; border: 1px solid #6e908122; border-radius: 50%; box-shadow: 0 0 0 35px #6e90810a, 0 0 0 72px #6e908108; }
        .intro-copy, .intro-foot { position: relative; z-index: 1; }
        .eyebrow { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 26px; color: var(--sage-dark); font-size: 11px; font-weight: 750; letter-spacing: 1.7px; text-transform: uppercase; }
        .eyebrow:before { content: ""; width: 20px; height: 1px; background: #729188; }
        h1 { max-width: 410px; margin: 0 0 18px; color: #1f2b33; font-family: Georgia, "Times New Roman", serif; font-size: clamp(38px, 4vw, 52px); font-weight: 500; letter-spacing: -1.9px; line-height: 1.08; }
        .intro-copy > p { max-width: 390px; margin: 0; color: #65746d; font-size: 16px; line-height: 1.75; }
        .benefits { display: grid; gap: 18px; margin: 38px 0 0; padding: 0; list-style: none; }
        .benefits li { display: flex; align-items: flex-start; gap: 12px; color: #46584f; font-size: 14px; line-height: 1.5; }
        .check { display: grid; flex: 0 0 23px; height: 23px; place-items: center; border-radius: 50%; color: var(--sage-dark); background: #d7e5db; font-size: 13px; font-weight: 700; }
        .intro-foot { color: #77857d; font-size: 12px; }
        .form-side { padding: 46px clamp(28px, 5vw, 62px) 42px; }
        .back-link { display: inline-block; margin-bottom: 31px; font-size: 13px; }
        .form-heading { margin-bottom: 27px; }
        .form-heading h2 { margin: 0 0 7px; color: var(--ink); font-size: 25px; font-weight: 700; letter-spacing: -.7px; }
        .form-heading p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
        .section-label { display: flex; align-items: center; gap: 12px; margin: 25px 0 17px; color: var(--sage-dark); font-size: 11px; font-weight: 750; letter-spacing: 1.1px; text-transform: uppercase; }
        .section-label:after { content: ""; flex: 1; height: 1px; background: var(--line); }
        .field { margin-bottom: 15px; }
        .field label { display: block; margin: 0 0 7px; color: #3d4b45; font-size: 12px; font-weight: 650; }
        .field .form-control { height: 46px; padding: 10px 13px; border: 1px solid #dce4de; border-radius: 9px; color: var(--ink); background: #fff; box-shadow: none; font-size: 14px; transition: border-color .15s, box-shadow .15s; }
        .field .form-control::placeholder { color: #a1aca5; }
        .field .form-control:focus { border-color: #709186; box-shadow: 0 0 0 3px #71928620; }
        .field .input-validation-error { border-color: #c85e5e; }
        .field-validation-error, .validation-summary-errors { color: #a94442; font-size: 12px; }
        .validation-summary-errors { margin-bottom: 15px; padding: 11px 13px; border: 1px solid #f0d5d4; border-radius: 8px; background: #fff7f6; }
        .validation-summary-errors ul { margin: 0; padding-left: 18px; }
        .field-hint { display: block; margin-top: 6px; color: #8a968f; font-size: 11px; }
        .name-row, .password-row { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
        .password-wrap { position: relative; }
        .password-wrap .form-control { padding-right: 62px; }
        .toggle-password { position: absolute; top: 0; right: 0; width: 58px; height: 46px; border: 0; color: #718079; background: transparent; font-size: 12px; font-weight: 650; }
        .submit { width: 100%; min-height: 49px; margin-top: 7px; border: 0; border-radius: 10px; color: #fff; background: var(--sage); box-shadow: 0 8px 18px #42695d25; font-size: 14px; font-weight: 700; transition: background .15s, transform .15s; }
        .submit:hover { color: #fff; background: var(--sage-dark); transform: translateY(-1px); }
        .submit:focus-visible, .toggle-password:focus-visible, a:focus-visible { outline: 3px solid #7ca295; outline-offset: 3px; }
        .privacy { margin: 14px 0 0; color: #89948d; text-align: center; font-size: 11px; line-height: 1.55; }
        @@media (max-width: 850px) { .page { grid-template-columns: 1fr; max-width: 620px; margin-top: 26px; } .intro { min-height: auto; padding: 37px 36px; } .intro-foot { margin-top: 28px; } .form-side { padding: 34px 36px 38px; } .benefits { grid-template-columns: 1fr 1fr; gap: 12px; } }
        @@media (max-width: 540px) { .topbar { height: 64px; padding: 0 20px; } .page { width: calc(100% - 24px); margin: 12px auto 28px; border-radius: 17px; } .intro { padding: 30px 25px; } h1 { font-size: 39px; } .intro-copy > p { font-size: 14px; } .benefits { grid-template-columns: 1fr; margin-top: 25px; } .form-side { padding: 27px 23px 30px; } .back-link { margin-bottom: 24px; } .form-heading h2 { font-size: 22px; } .name-row, .password-row { grid-template-columns: 1fr; gap: 0; } }
    </style>
</head>
<body>
    <div style="max-width:440px;margin:20px auto;padding:0 24px"><partial name="_GoogleAccess" /></div>
    <header class="topbar">
        <a class="brand" href="@Url.Action("Index", "SaaS")" aria-label="ScheLink, inicio"><span class="brand-mark">✦</span><span class="brand-word">ScheLink</span></a>
        <a class="top-link" href="@Url.Content("~/Login/Index")">¿Ya tienes una cuenta? Ingresar</a>
    </header>
    <main class="page">
        <section class="intro" aria-labelledby="intro-title">
            <div class="intro-copy">
                <div class="eyebrow">Gestión que te acompaña</div>
                <h1 id="intro-title">Un espacio para cuidar mejor.</h1>
                <p>Organiza tu centro con calma y claridad. Empieza creando tu espacio de trabajo y deja lo operativo en buenas manos.</p>
                <ul class="benefits">
                    <li><span class="check" aria-hidden="true">✓</span><span>Tu empresa y sede principal, listas para empezar.</span></li>
                    <li><span class="check" aria-hidden="true">✓</span><span>Una cuenta administradora para configurar tu equipo.</span></li>
                    <li><span class="check" aria-hidden="true">✓</span><span>Pacientes, agenda y gestión en un mismo lugar.</span></li>
                </ul>
            </div>
            <div class="intro-foot">Hecho para que puedas enfocarte en las personas.</div>
        </section>
        <section class="form-side" aria-labelledby="form-title">
            <a class="back-link" href="@Url.Action("Index", "SaaS")">← Volver a ScheLink</a>
            <div class="form-heading">
                <h2 id="form-title">Crea tu espacio de prueba</h2>
                <p>Completa tus datos. Solo te llevará unos minutos.</p>
            </div>
            <form asp-action="Registro" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="section-label">Tu centro</div>
                <div class="field">
                    <label asp-for="Empresa">Nombre de la empresa o centro</label>
                    <input asp-for="Empresa" class="form-control" placeholder="Ej. Centro Sentirse Bien" autocomplete="organization" />
                    <span asp-validation-for="Empresa"></span>
                </div>
                <div class="field">
                    <label asp-for="Sede">Nombre de la sede principal</label>
                    <input asp-for="Sede" class="form-control" placeholder="Ej. Sede Miraflores" autocomplete="off" />
                    <span asp-validation-for="Sede"></span>
                </div>
                <div class="section-label">Tu cuenta administradora</div>
                <div class="name-row">
                    <div class="field">
                        <label asp-for="Nombres">Nombres</label>
                        <input asp-for="Nombres" class="form-control" placeholder="Tus nombres" autocomplete="given-name" />
                        <span asp-validation-for="Nombres"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Apellidos">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control" placeholder="Tus apellidos" autocomplete="family-name" />
                        <span asp-validation-for="Apellidos"></span>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Usuario">Usuario</label>
                    <input asp-for="Usuario" class="form-control" placeholder="Solo letras, sin espacios" autocomplete="username" />
                    <span asp-validation-for="Usuario"></span>
                    <small class="field-hint">Lo usarás para iniciar sesión.</small>
                </div>
                <div class="password-row">
                    <div class="field">
                        <label asp-for="Password">Contraseña</label>
                        <div class="password-wrap">
                            <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                            <button class="toggle-password" type="button" data-password-toggle="Password" aria-label="Mostrar contraseña" aria-pressed="false">Ver</button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
                        <div class="password-wrap">
                            <input asp-for="ConfirmarPassword" class="form-control" placeholder="Repite tu contraseña" autocomplete="new-password" />
                            <button class="toggle-password" type="button" data-password-toggle="ConfirmarPassword" aria-label="Mostrar contraseña" aria-pressed="false">Ver</button>
                        </div>
                        <span asp-validation-for="ConfirmarPassword"></span>
                    </div>
                </div>
                <button class="submit" type="submit">Crear mi espacio <span aria-hidden="true">→</span></button>
                <p class="privacy">Al continuar, se crearán tu empresa, sede principal y cuenta administradora.</p>
            </form>
        </section>
    </main>
    <script>
        document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
            button.addEventListener("click", function () {
                var input = document.getElementById(button.dataset.passwordToggle);
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                button.textContent = show ? "Ocultar" : "Ver";
                button.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
                button.setAttribute("aria-pressed", show.toString());
            });
        });
    </script>
</body>
</html>
